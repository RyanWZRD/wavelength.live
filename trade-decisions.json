  "guardrails": {
    "research_only": true,
    "no_order_submission": true,
    "no_live_sizing": true,
    "no_executable_exit_orders": true,
    "missing_data_fails_closed": true,
    "manual_review_required": true,
    "stable_or_cashlike_assets_excluded": true
  }
}
